# Docker network names discovered with docker inspect (not container names).
CADDY_NETWORK=n8n_n8n_network
POSTGRES_NETWORK=postgres_postgres_private

PORT=3000
DB_HOST=postgres
DB_PORT=5432
DB_NAME=personal_app_db
DB_USER=personal_app_user
DB_PASSWORD=replace-with-the-existing-runtime-db-password
DB_SSL=false

# Generate with: openssl rand -hex 32
API_TOKEN=replace-with-at-least-32-random-characters

# Exact frontend origin; no trailing slash. It is not changed yet.
ALLOWED_ORIGIN=https://inventor-house-management.vercel.app
JSON_LIMIT=1mb
